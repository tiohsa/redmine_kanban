{
  "name": "agent-first-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dep:check": "depcruise layers packages contracts",
    "test:guardrails": "vitest run tests/guardrails",
    "test:verification": "vitest run tests/verification",
    "verify:run": "tsx verification/driver-cli.ts",
    "verify:all": "npm run lint && npm run typecheck && npm run dep:check && npm run test:guardrails && npm run test:verification && npm run verify:run"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "next": "^15.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}

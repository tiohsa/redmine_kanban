<div id='redmine-kanban-root'
     data-project-id='<%= @project.id %>'
     data-data-url='<%= redmine_kanban_data_path(project_id: @project.identifier) %>'
     data-current-user-id='<%= User.current.id %>'
     data-labels='<%= ERB::Util.html_escape(@initial_labels.to_json) %>'>
</div>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'redmine_kanban_spa', plugin: 'redmine_kanban' %>
  <%= javascript_include_tag 'redmine_kanban_spa', plugin: 'redmine_kanban' %>
<% end %>

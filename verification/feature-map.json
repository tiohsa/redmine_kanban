{
  "version": "1.0.0",
  "defaults": {
    "performanceBudgets": {
      "maxFrameTimeMs": 16,
      "maxLatencyMs": 200,
      "maxMemoryMb": 256
    }
  },
  "features": [
    {
      "id": "reference-example",
      "name": "Reference Example",
      "description": "Golden sample feature demonstrating agent-first execution boundaries, shared contracts, and deterministic runtime verification.",
      "navigation": {
        "path": "/reference-example",
        "shortcuts": ["Alt+R"]
      },
      "selectors": {
        "root": "[data-feature=\"reference-example\"]",
        "actions": {
          "inputTitle": "[data-feature=\"reference-example\"] [data-action=\"input-title\"]",
          "createItem": "[data-feature=\"reference-example\"] [data-action=\"create-item\"]",
          "refreshItems": "[data-feature=\"reference-example\"] [data-action=\"refresh-items\"]"
        },
        "attributes": {
          "dataFeature": "reference-example",
          "dataActions": ["input-title", "create-item", "refresh-items"]
        }
      },
      "entryPoints": {
        "frontend": "layers/frontend/entry-points/reference-example-page.tsx",
        "backend": "layers/backend/entry-points/server.ts",
        "httpRoute": {
          "method": "GET",
          "path": "/api/reference-example"
        }
      },
      "steps": [
        {
          "id": "navigate-to-feature",
          "type": "navigate",
          "target": "/reference-example",
          "expectSelector": "[data-feature=\"reference-example\"]"
        },
        {
          "id": "list-reference-items",
          "type": "http",
          "method": "GET",
          "path": "/api/reference-example",
          "expectStatus": 200
        },
        {
          "id": "create-reference-item",
          "type": "http",
          "method": "POST",
          "path": "/api/reference-example",
          "payload": {
            "title": "Verification Probe Item"
          },
          "expectStatus": 201
        },
        {
          "id": "trigger-create-action",
          "type": "action",
          "action": "create-item",
          "shortcut": "Alt+R",
          "expectAttribute": {
            "dataFeature": "reference-example",
            "dataAction": "create-item"
          }
        },
        {
          "id": "trigger-refresh-action",
          "type": "action",
          "action": "refresh-items",
          "expectAttribute": {
            "dataFeature": "reference-example",
            "dataAction": "refresh-items"
          }
        }
      ],
      "invariants": [
        "Feature root exposes data-feature=\"reference-example\"",
        "Create and refresh actions expose data-action=\"create-item\" and data-action=\"refresh-items\"",
        "Backend entry point responds with contract-valid payload for GET and POST /api/reference-example",
        "Zero uncaught exceptions or console errors during flow execution"
      ],
      "performanceBudgets": {
        "maxFrameTimeMs": 16,
        "maxLatencyMs": 150,
        "maxMemoryMb": 256
      }
    }
  ]
}

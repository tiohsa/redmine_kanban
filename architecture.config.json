{
  "version": "1.0.0",
  "layers": {
    "frontend": {
      "path": "layers/frontend",
      "runtime": "nextjs",
      "entryPointsDir": "layers/frontend/entry-points",
      "featuresDir": "layers/frontend/features",
      "allowedImports": ["contracts", "packages/framework-core"]
    },
    "backend": {
      "path": "layers/backend",
      "runtime": "fastify",
      "entryPointsDir": "layers/backend/entry-points",
      "featuresDir": "layers/backend/features",
      "allowedImports": ["contracts", "packages/framework-core"]
    }
  },
  "shared": {
    "contracts": {
      "path": "contracts",
      "allowedImports": ["packages/framework-core"]
    },
    "frameworkCore": {
      "path": "packages/framework-core",
      "exemptFromBans": true,
      "forbiddenImports": ["layers"]
    }
  },
  "colocation": {
    "featureRootPattern": "layers/*/features/*",
    "publicEntryPoint": "index.ts",
    "privateDirectory": "internal",
    "referenceFeature": "reference-example"
  },
  "bannedApis": {
    "useEffect": {
      "replacement": "@framework-core/react#useManagedEffect",
      "message": "Raw useEffect is banned in product code. Use useManagedEffect from '@framework-core/react' instead."
    },
    "setTimeout": {
      "replacement": "@framework-core/timers#scheduleOnce",
      "message": "Imperative setTimeout is banned in product code. Use scheduleOnce from '@framework-core/timers' instead."
    },
    "setInterval": {
      "replacement": "@framework-core/timers#scheduleInterval",
      "message": "Imperative setInterval is banned in product code. Use scheduleInterval from '@framework-core/timers' instead."
    },
    "rawSql": {
      "replacement": "@framework-core/data#executeQuery",
      "message": "Raw SQL and unsafe database calls are banned in product code. Use executeQuery from '@framework-core/data' instead."
    }
  },
  "commentAndSuppressionBan": {
    "enabled": true,
    "targetGlobs": ["layers/**", "contracts/**"],
    "exemptGlobs": ["packages/framework-core/**"],
    "bannedDirectives": [
      "eslint-disable",
      "eslint-disable-next-line",
      "eslint-disable-line",
      "@ts-ignore",
      "@ts-expect-error",
      "@ts-nocheck"
    ]
  },
  "protectedPaths": [
    "architecture.config.json",
    "eslint.config.*",
    "eslint-rules/**",
    ".dependency-cruiser.*",
    "verification/**"
  ]
}
